# OpenFOAM run products (the 0/ directory of each case is INPUT and is tracked)
[1-9][0-9]*/
processor*/
postProcessing/
# any generated mesh, at any depth (blockMesh output is never input)
polyMesh/
log.*
*.e[0-9]*
*.o[0-9]*
__pycache__/
# build products and temporary files
*.o
*.so
*.dep
# wmake build directory, at any depth (linux64GccDPInt32Opt and similar)
linux*/
platforms/
*.swp

# exception: the 0/ directories of the cases are input
!cases/*/0/
!cases/*/0/**
