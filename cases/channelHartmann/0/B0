FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      B0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -2 0 0 -1 0];

internalField   uniform (0 0.76775643 0);

boundaryField
{
    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    lowerWall
    {
        type            fixedValue;
        value           uniform (0 0.76775643 0);
    }
    upperWall
    {
        type            fixedValue;
        value           uniform (0 0.76775643 0);
    }
    frontAndBack
    {
        type            empty;
    }
}

